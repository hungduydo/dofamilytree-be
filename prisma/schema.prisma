generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String    @id @db.Uuid
  comments Comment[]
  memories Memory[]
}

model Member {
  id                   String               @id @default(uuid()) @db.Uuid
  private_id           String?
  name                 String
  normalized_name      String?
  avatar_url           String?
  gender               String?
  birthDate            String?
  deathDate            String?
  tree_id              String?              @db.Uuid
  created_at           DateTime             @default(now())
  /// Thế hệ đã tính sẵn — giá trị HIỆU LỰC = profile.generation (nhập tay, ưu
  /// tiên) nếu có, ngược lại suy ra từ member_relationships. Ghi bởi job nền
  /// `generation-recompute`; đọc trực tiếp ở request path để không phải traverse
  /// đồ thị. Nguồn sự thật cho phần nhập tay vẫn là profiles.generation.
  generation            Int?
  generation_updated_at DateTime?
  anniversaries        Anniversary[]
  comments             Comment[]
  child_relationships  MemberRelationship[] @relation("RelChild")
  parent_relationships MemberRelationship[] @relation("RelParent")
  profile              Profile?
  from_relationships   Relationship[]       @relation("FromMember")
  to_relationships     Relationship[]       @relation("ToMember")
  user_metadata        UserMetadata?
  tree                 Tree?                @relation(fields: [tree_id], references: [id])
  cemeteries           Cemetery[]
  media                Media[]
  event_attendances    EventAttendee[]
  life_events          LifeEvent[]
  memories             Memory[]

  @@index([normalized_name])
  @@index([name])
  @@index([tree_id])
  @@index([generation])
  // Lọc + sắp xếp cho GET /v2/members — xem 002_member_search_and_filter_indexes.sql.
  // `map:` tường minh để tên khớp CHÍNH XÁC file SQL (Prisma tự sinh tên dài hơn
  // như members_generation_created_at_id_idx → migrate diff sẽ báo drift).
  @@index([created_at(sort: Desc), id], map: "members_created_at_id_idx")
  @@index([generation, created_at(sort: Desc), id], map: "members_generation_created_at_idx")
  @@index([tree_id, created_at(sort: Desc), id], map: "members_tree_created_at_idx")
  @@index([gender, created_at(sort: Desc), id], map: "members_gender_created_at_idx")
  /// GIN trigram cho `ILIKE '%x%'` (nameSearchWhere). Cần extension pg_trgm.
  /// `map:` tường minh để không đụng tên với btree members_normalized_name_idx /
  /// members_name_idx ở trên (Prisma tự sinh tên trùng nếu không đặt).
  @@index([normalized_name(ops: raw("gin_trgm_ops"))], type: Gin, map: "members_normalized_name_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "members_name_trgm_idx")
  @@map("members")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  member_id      String   @unique @db.Uuid
  fullName       String
  generation     Int?
  biography      String?
  occupation     String?
  address        String?
  notes          String?
  phone          String?
  contactEmail   String?
  familyPosition String?
  roleTags       String[] @default([])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  committeeRole  String?
  isCommittee    Boolean  @default(false)
  isNotable      Boolean  @default(false)
  member         Member   @relation(fields: [member_id], references: [id])

  /// profiles_is_committee_idx / profiles_is_notable_idx là index PHẦN
  /// (`WHERE "isCommittee"` / `WHERE "isNotable"`), Prisma KHÔNG biểu diễn được.
  /// Chúng chỉ tồn tại trong 002_member_search_and_filter_indexes.sql —
  /// `migrate diff` không thấy. Chuẩn bị cho Phase 2 (đổi predicate committee/notable).
  @@map("profiles")
}

model Relationship {
  id             String           @id @default(uuid()) @db.Uuid
  from_member_id String           @db.Uuid
  to_member_id   String           @db.Uuid
  type           RelationshipType
  created_at     DateTime         @default(now())
  from_member    Member           @relation("FromMember", fields: [from_member_id], references: [id])
  to_member      Member           @relation("ToMember", fields: [to_member_id], references: [id])

  @@index([from_member_id])
  @@index([to_member_id])
  @@map("relationships")
}

model MemberRelationship {
  id         String                 @id @default(uuid()) @db.Uuid
  parent_id  String                 @db.Uuid
  child_id   String                 @db.Uuid
  type       RelationshipNatureType
  note       String?
  created_at DateTime               @default(now())
  child      Member                 @relation("RelChild", fields: [child_id], references: [id])
  parent     Member                 @relation("RelParent", fields: [parent_id], references: [id])

  @@index([parent_id, type])
  @@index([child_id, type])
  @@map("member_relationships")
}

model Tree {
  id          String   @id @default(uuid()) @db.Uuid
  owner_id    String   @db.Uuid
  created_at  DateTime @default(now())
  description String?
  image       String?
  title       String?
  show        Boolean  @default(false)
  members     Member[]

  @@index([owner_id])
  @@map("trees")
}

model Comment {
  id               String   @id @default(uuid()) @db.Uuid
  content          String
  author_id        String   @db.Uuid
  target_member_id String?  @db.Uuid
  created_at       DateTime @default(now())
  author           User     @relation(fields: [author_id], references: [id])
  target_member    Member?  @relation(fields: [target_member_id], references: [id])

  @@index([target_member_id])
  @@index([author_id])
  @@map("comments")
}

model Media {
  id               String      @id @default(uuid()) @db.Uuid
  file_path        String
  uploader_id      String      @db.Uuid
  uploader_name    String?
  title            String?
  /// Tên đã bỏ dấu để tìm kiếm VN-insensitive — song song title, giống members.normalized_name.
  normalized_title String?
  type             String?
  /// MIME gốc của file (image/jpeg, video/mp4…). Dùng để phân loại + trả về FE.
  mime_type        String?
  /// Lọc theo tag (mảng text), giống Profile.roleTags. GIN index cho `has`/`hasSome`.
  tags             String[]    @default([])
  /// Thời lượng video/audio (giây). FE gửi lúc upload — backend không trích xuất.
  duration_seconds Int?
  member_id        String?     @db.Uuid
  album_id         String?     @db.Uuid
  event_id         String?     @db.Uuid
  /// pending → đã tạo record, chờ upload nền; ready → đã lên Blob; failed → job lỗi.
  status           String      @default("pending")
  views            Int         @default(0)
  size_bytes       Int?
  created_at       DateTime    @default(now())
  member           Member?     @relation(fields: [member_id], references: [id])
  album            MediaAlbum? @relation(fields: [album_id], references: [id])
  event            Event?      @relation(fields: [event_id], references: [id])

  // Xem prisma/manual-migrations/003_media_library_indexes.sql — `map:` tường minh
  // để tên khớp CHÍNH XÁC file SQL (Prisma tự sinh tên khác → migrate diff báo drift).
  @@index([created_at(sort: Desc), id], map: "media_created_at_id_idx")
  @@index([type, created_at(sort: Desc), id], map: "media_type_created_at_idx")
  @@index([views(sort: Desc), id], map: "media_views_idx")
  @@index([event_id, created_at(sort: Desc), id], map: "media_event_created_at_idx")
  @@index([album_id, created_at(sort: Desc), id], map: "media_album_created_at_idx")
  @@index([uploader_id, created_at(sort: Desc), id], map: "media_uploader_created_at_idx")
  @@index([member_id, created_at(sort: Desc), id], map: "media_member_created_at_idx")
  /// GIN trigram cho tìm kiếm `ILIKE '%x%'` trên normalized_title. Cần pg_trgm.
  @@index([normalized_title(ops: raw("gin_trgm_ops"))], type: Gin, map: "media_normalized_title_trgm_idx")
  /// GIN cho lọc tag (array containment).
  @@index([tags], type: Gin, map: "media_tags_gin_idx")
  @@map("media")
}

model MediaAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  cover_url   String?
  date        String?
  created_at  DateTime @default(now())
  media       Media[]

  @@map("media_albums")
}

model Article {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  excerpt    String?
  content    String
  category   String
  date       DateTime @default(now())
  views      Int      @default(0)
  featured   Boolean  @default(false)
  coverUrl   String?
  author_id  String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@map("articles")
}

model UserMetadata {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @unique @db.Uuid
  profile_member_id String?  @unique @db.Uuid
  roles             String[]
  profile_member    Member?  @relation(fields: [profile_member_id], references: [id])

  @@map("user_metadata")
}

model Cemetery {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  latitude         Float?
  longitude        Float?
  description      String?
  member_id        String?       @db.Uuid
  deathDate        String?
  relocationDate   String?
  constructionDate String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  member           Member?       @relation(fields: [member_id], references: [id])
  anniversaries    Anniversary[]

  @@index([member_id])
  @@map("cemeteries")
}

model Anniversary {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  date        DateTime
  description String?
  member_id   String?   @db.Uuid
  cemetery_id String?   @db.Uuid
  isLunar     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  member      Member?   @relation(fields: [member_id], references: [id])
  cemetery    Cemetery? @relation(fields: [cemetery_id], references: [id])

  @@index([member_id])
  @@index([cemetery_id])
  @@map("anniversaries")
}

model Event {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  description String?
  images      String[]
  highlight   Boolean         @default(false)
  date        DateTime?
  end_date    DateTime?
  location    String?
  category    String?
  isLunar     Boolean         @default(false)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  attendees   EventAttendee[]
  media       Media[]

  @@map("events")
}

model EventAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  event_id    String   @db.Uuid
  member_id   String   @db.Uuid
  rsvp_status String   @default("going")
  created_at  DateTime @default(now())
  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [member_id], references: [id])

  @@unique([event_id, member_id])
  @@index([event_id])
  @@index([member_id])
  @@map("event_attendees")
}

model LifeEvent {
  id          String   @id @default(uuid()) @db.Uuid
  member_id   String   @db.Uuid
  date        String
  title       String
  description String?
  category    String?
  created_at  DateTime @default(now())
  member      Member   @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@map("life_events")
}

model Memory {
  id         String   @id @default(uuid()) @db.Uuid
  member_id  String?  @db.Uuid
  event_id   String?  @db.Uuid
  author_id  String   @db.Uuid
  text       String
  photos     String[] @default([])
  created_at DateTime @default(now())
  member     Member?  @relation(fields: [member_id], references: [id])
  author     User     @relation(fields: [author_id], references: [id])

  @@index([member_id])
  @@index([event_id])
  @@map("memories")
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
}

enum RelationshipNatureType {
  BIOLOGICAL
  ADOPTED
  SPOUSE
}

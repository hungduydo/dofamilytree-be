generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String    @id @db.Uuid
  comments Comment[]
  memories Memory[]
}

model Member {
  id                    String               @id @default(uuid()) @db.Uuid
  private_id            String?
  name                  String
  normalized_name       String?
  avatar_url            String?
  gender                String?
  birthDate             String?
  deathDate             String?
  tree_id               String?              @db.Uuid
  created_at            DateTime             @default(now())
  /// Thế hệ đã tính sẵn — giá trị HIỆU LỰC = profile.generation (nhập tay, ưu
  /// tiên) nếu có, ngược lại suy ra từ member_relationships. Ghi bởi job nền
  /// `generation-recompute`; đọc trực tiếp ở request path để không phải traverse
  /// đồ thị. Nguồn sự thật cho phần nhập tay vẫn là profiles.generation.
  generation            Int?
  generation_updated_at DateTime?
  anniversaries         Anniversary[]
  cemeteries            Cemetery[]
  comments              Comment[]
  event_attendances     EventAttendee[]
  life_events           LifeEvent[]
  media                 Media[]
  child_relationships   MemberRelationship[] @relation("RelChild")
  parent_relationships  MemberRelationship[] @relation("RelParent")
  tree                  Tree?                @relation(fields: [tree_id], references: [id])
  memorial_incense      MemorialIncense[]
  memorial_tributes     MemorialTribute[]
  memories              Memory[]
  profile               Profile?
  from_relationships    Relationship[]       @relation("FromMember")
  to_relationships      Relationship[]       @relation("ToMember")
  user_metadata         UserMetadata?

  @@index([normalized_name])
  @@index([name])
  @@index([tree_id])
  @@index([generation])
  @@index([created_at(sort: Desc), id])
  @@index([generation, created_at(sort: Desc), id], map: "members_generation_created_at_idx")
  @@index([tree_id, created_at(sort: Desc), id], map: "members_tree_created_at_idx")
  @@index([gender, created_at(sort: Desc), id], map: "members_gender_created_at_idx")
  @@index([normalized_name(ops: raw("gin_trgm_ops"))], map: "members_normalized_name_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "members_name_trgm_idx", type: Gin)
  @@map("members")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  member_id      String   @unique @db.Uuid
  fullName       String
  generation     Int?
  biography      String?
  occupation     String?
  address        String?
  notes          String?
  phone          String?
  contactEmail   String?
  familyPosition String?
  roleTags       String[] @default([])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  committeeRole  String?
  isCommittee    Boolean  @default(false)
  isNotable      Boolean  @default(false)
  member         Member   @relation(fields: [member_id], references: [id])

  @@map("profiles")
}

model Relationship {
  id             String           @id @default(uuid()) @db.Uuid
  from_member_id String           @db.Uuid
  to_member_id   String           @db.Uuid
  type           RelationshipType
  created_at     DateTime         @default(now())
  from_member    Member           @relation("FromMember", fields: [from_member_id], references: [id])
  to_member      Member           @relation("ToMember", fields: [to_member_id], references: [id])

  @@index([from_member_id])
  @@index([to_member_id])
  @@map("relationships")
}

model MemberRelationship {
  id         String                 @id @default(uuid()) @db.Uuid
  parent_id  String                 @db.Uuid
  child_id   String                 @db.Uuid
  type       RelationshipNatureType
  note       String?
  created_at DateTime               @default(now())
  child      Member                 @relation("RelChild", fields: [child_id], references: [id])
  parent     Member                 @relation("RelParent", fields: [parent_id], references: [id])

  @@index([parent_id, type])
  @@index([child_id, type])
  @@map("member_relationships")
}

model Tree {
  id          String   @id @default(uuid()) @db.Uuid
  owner_id    String   @db.Uuid
  created_at  DateTime @default(now())
  description String?
  image       String?
  title       String?
  show        Boolean  @default(false)
  members     Member[]

  @@index([owner_id])
  @@map("trees")
}

model Comment {
  id               String   @id @default(uuid()) @db.Uuid
  content          String
  author_id        String   @db.Uuid
  target_member_id String?  @db.Uuid
  created_at       DateTime @default(now())
  author           User     @relation(fields: [author_id], references: [id])
  target_member    Member?  @relation(fields: [target_member_id], references: [id])

  @@index([target_member_id])
  @@index([author_id])
  @@map("comments")
}

model Media {
  id               String      @id @default(uuid()) @db.Uuid
  file_path        String
  uploader_id      String      @db.Uuid
  uploader_name    String?
  title            String?
  /// Tên đã bỏ dấu để tìm kiếm VN-insensitive — song song title, giống members.normalized_name.
  normalized_title String?
  type             String?
  /// MIME gốc của file (image/jpeg, video/mp4…). Dùng để phân loại + trả về FE.
  mime_type        String?
  /// Lọc theo tag (mảng text), giống Profile.roleTags. GIN index cho `has`/`hasSome`.
  tags             String[]    @default([])
  /// Thời lượng video/audio (giây). FE gửi lúc upload — backend không trích xuất.
  duration_seconds Int?
  member_id        String?     @db.Uuid
  album_id         String?     @db.Uuid
  event_id         String?     @db.Uuid
  /// pending → đã tạo record, chờ upload nền; ready → đã lên Blob; failed → job lỗi.
  status           String      @default("pending")
  views            Int         @default(0)
  size_bytes       Int?
  created_at       DateTime    @default(now())
  album            MediaAlbum? @relation(fields: [album_id], references: [id])
  event            Event?      @relation(fields: [event_id], references: [id])
  member           Member?     @relation(fields: [member_id], references: [id])

  @@index([created_at(sort: Desc), id])
  @@index([type, created_at(sort: Desc), id], map: "media_type_created_at_idx")
  @@index([views(sort: Desc), id], map: "media_views_idx")
  @@index([event_id, created_at(sort: Desc), id], map: "media_event_created_at_idx")
  @@index([album_id, created_at(sort: Desc), id], map: "media_album_created_at_idx")
  @@index([uploader_id, created_at(sort: Desc), id], map: "media_uploader_created_at_idx")
  @@index([member_id, created_at(sort: Desc), id], map: "media_member_created_at_idx")
  @@index([normalized_title(ops: raw("gin_trgm_ops"))], map: "media_normalized_title_trgm_idx", type: Gin)
  @@index([tags], map: "media_tags_gin_idx", type: Gin)
  @@map("media")
}

model MediaAlbum {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  cover_url   String?
  date        String?
  created_at  DateTime @default(now())
  media       Media[]

  @@map("media_albums")
}

model Article {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  excerpt    String?
  content    String
  category   String
  date       DateTime @default(now())
  views      Int      @default(0)
  featured   Boolean  @default(false)
  coverUrl   String?
  author_id  String?  @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@map("articles")
}

model UserMetadata {
  id                String    @id @default(uuid()) @db.Uuid
  user_id           String    @unique @db.Uuid
  profile_member_id String?   @unique @db.Uuid
  roles             String[]
  /// Thông tin người dùng TỰ KHAI lúc đăng ký (fullName/gender/birthDate/
  /// deathDate/generation/occupation/address/biography/avatarUrl). CHƯA được
  /// xác minh — admin đọc để quyết định link tài khoản vào Member NÀO.
  /// KHÔNG phải nguồn sự thật; members/profiles mới là.
  claim_request     Json?
  created_at        DateTime  @default(now())
  /// Thời điểm admin gắn tài khoản này vào một Member. null = còn là guest.
  linked_at         DateTime?
  profile_member    Member?   @relation(fields: [profile_member_id], references: [id])

  @@index([created_at(sort: Desc), id])
  @@map("user_metadata")
}

model Cemetery {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  latitude         Float?
  longitude        Float?
  description      String?
  member_id        String?       @db.Uuid
  deathDate        String?
  relocationDate   String?
  constructionDate String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  anniversaries    Anniversary[]
  member           Member?       @relation(fields: [member_id], references: [id])

  @@index([member_id])
  @@map("cemeteries")
}

model Anniversary {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  date        DateTime
  description String?
  member_id   String?   @db.Uuid
  cemetery_id String?   @db.Uuid
  isLunar     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  cemetery    Cemetery? @relation(fields: [cemetery_id], references: [id])
  member      Member?   @relation(fields: [member_id], references: [id])

  @@index([member_id])
  @@index([cemetery_id])
  @@map("anniversaries")
}

model Event {
  id          String          @id @default(uuid()) @db.Uuid
  title       String
  description String?
  images      String[]
  highlight   Boolean         @default(false)
  date        DateTime?
  end_date    DateTime?
  location    String?
  category    String?
  isLunar     Boolean         @default(false)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  attendees   EventAttendee[]
  media       Media[]

  @@map("events")
}

model EventAttendee {
  id          String   @id @default(uuid()) @db.Uuid
  event_id    String   @db.Uuid
  member_id   String   @db.Uuid
  rsvp_status String   @default("going")
  created_at  DateTime @default(now())
  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [member_id], references: [id])

  @@unique([event_id, member_id])
  @@index([event_id])
  @@index([member_id])
  @@map("event_attendees")
}

model LifeEvent {
  id          String   @id @default(uuid()) @db.Uuid
  member_id   String   @db.Uuid
  date        String
  title       String
  description String?
  category    String?
  created_at  DateTime @default(now())
  member      Member   @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@map("life_events")
}

model Memory {
  id         String   @id @default(uuid()) @db.Uuid
  member_id  String?  @db.Uuid
  event_id   String?  @db.Uuid
  author_id  String   @db.Uuid
  text       String
  photos     String[] @default([])
  created_at DateTime @default(now())
  author     User     @relation(fields: [author_id], references: [id])
  member     Member?  @relation(fields: [member_id], references: [id])

  @@index([member_id])
  @@index([event_id])
  @@map("memories")
}

/// Một nén hương. Không mang danh tính tự do: tác giả luôn là `User` thật, nên
/// lượt thắp có thể chặn trùng và truy vết được.
model MemorialIncense {
  id         String   @id @default(uuid()) @db.Uuid
  /// null = thắp cho tổ tiên nói chung (nút "Thắp hương" ở ban thờ).
  member_id  String?  @db.Uuid
  /// CỐ Ý không có @relation sang `User` và không có FK dưới DB. Bảng
  /// public."User" TRỐNG (0 dòng) — danh tính thật nằm ở auth.users của
  /// Supabase. `memories` có FK author_id -> "User"(id) và vì thế MỌI insert
  /// vào bảng đó đều vi phạm FK (memories cũng đang trống). Đừng lặp lại.
  user_id    String   @db.Uuid
  /// Ngày theo giờ VN (Asia/Ho_Chi_Minh), do APP tính chứ không phải DB —
  /// `now()` của Postgres là UTC, sau 17h giờ VN sẽ nhảy sang ngày hôm sau.
  /// Cột này tồn tại CHỈ để hai partial unique index chặn thắp trùng trong
  /// ngày; Prisma không diễn đạt được partial unique nên chúng chỉ nằm trong
  /// prisma/manual-migrations/005_memorial.sql. ĐỪNG bỏ cột này đi.
  offered_on DateTime @db.Date
  created_at DateTime @default(now())
  member     Member?  @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@index([user_id, created_at(sort: Desc)], map: "memorial_incense_user_created_idx")
  @@map("memorial_incense")
}

/// Lời tưởng niệm. `onDelete` lệch với MemorialIncense là CỐ Ý: xoá một member
/// không được xoá những lời người ta viết về họ (SetNull), nhưng số nén hương
/// thì vô nghĩa nếu không còn người nhận (Cascade).
model MemorialTribute {
  id          String   @id @default(uuid()) @db.Uuid
  content     String   @db.VarChar(500)
  /// null = lời tưởng niệm gửi tổ tiên nói chung.
  member_id   String?  @db.Uuid
  /// CỐ Ý không có @relation sang `User` và không có FK dưới DB. Bảng
  /// public."User" TRỐNG (0 dòng) — danh tính thật nằm ở auth.users của
  /// Supabase. `memories` có FK author_id -> "User"(id) và vì thế MỌI insert
  /// vào bảng đó đều vi phạm FK (memories cũng đang trống). Đừng lặp lại.
  user_id     String   @db.Uuid
  /// Tên tác giả CHỐT LÚC GHI. Denormalize là cố ý: `User` ở schema này gần
  /// như rỗng (auth nằm bên Supabase Auth), nên resolve lúc ĐỌC sẽ tốn một
  /// network call sang Supabase cho MỖI lời tưởng niệm. Xem resolveAuthorName.
  author_name String
  created_at  DateTime @default(now())
  member      Member?  @relation(fields: [member_id], references: [id])

  @@index([created_at(sort: Desc), id(sort: Desc)], map: "memorial_tribute_created_id_idx")
  @@index([member_id, created_at(sort: Desc), id(sort: Desc)], map: "memorial_tribute_member_created_idx")
  @@map("memorial_tribute")
}

/// Dòng DUY NHẤT chứa thông tin liên hệ của dòng họ. Singleton ép bằng
/// `@default("default")` trên khoá chính: mọi upsert đều nhắm id="default" nên
/// không bao giờ đẻ ra dòng thứ hai.
///
/// `id` KHÔNG phải @db.Uuid (khác mọi bảng còn lại trong schema này) — đó là
/// CỐ Ý: giá trị là chuỗi "default", không phải uuid. Đổi sang uuid là mất luôn
/// cơ chế singleton.
model ContactInfo {
  id            String   @id @default("default")
  /// Nhà thờ họ. Nullable CẢ KHỐI: một chi họ có thể chưa có nhà thờ riêng.
  venue_name    String?
  venue_address String?
  venue_image   String?
  /// "Nhiệm kỳ 2023 – 2028" — clan tự soạn, trả nguyên văn.
  board_term    String?
  /// Số ngày làm việc ban liên lạc hứa trả lời. FE dựng phụ đề form từ số này.
  response_days Int?
  updated_at    DateTime @updatedAt

  channels ContactChannel[]
  hours    ContactHours[]

  @@map("contact_info")
}

model ContactChannel {
  id       String      @id @default(uuid()) @db.Uuid
  info_id  String
  info     ContactInfo @relation(fields: [info_id], references: [id], onDelete: Cascade)
  /// 'address' | 'phone' | 'email' | 'group'. KHÔNG phải enum của Postgres:
  /// FE đã chốt bốn giá trị này trong ContactChannel['type'], và một enum DB
  /// buộc phải migrate mới thêm được loại kênh thứ năm.
  type     String
  label    String
  value    String
  /// Có thể null — channelHref() bên FE tự suy `tel:`/`mailto:` từ `value`.
  href     String?
  position Int         @default(0)

  @@index([info_id, position])
  @@map("contact_channel")
}

model ContactHours {
  id       String      @id @default(uuid()) @db.Uuid
  info_id  String
  info     ContactInfo @relation(fields: [info_id], references: [id], onDelete: Cascade)
  label    String
  value    String
  position Int         @default(0)

  @@index([info_id, position])
  @@map("contact_hours")
}

/// Hộp thư đến của ban liên lạc.
model ContactMessage {
  id             String   @id @default(uuid()) @db.Uuid
  /// Mã ngắn người nhà đọc qua điện thoại: "LH-2608-0431". KHÔNG phải bộ đếm
  /// tăng dần — số thứ tự làm lộ ban liên lạc nhận bao nhiêu thư mỗi tháng.
  reference_code String   @unique
  /// GENEALOGY | GRAVE | EVENT | SCHOLARSHIP | OTHER (CONTACT_TOPICS).
  topic          String
  full_name      String
  phone          String
  email          String?
  branch         String?
  content        String   @db.VarChar(2000)
  /// [{ url, name, mimeType, size }] — xem ContactAttachment.
  attachments    Json     @default("[]")
  /// NEW | IN_PROGRESS | ANSWERED | SPAM (CONTACT_STATUSES).
  status         String   @default("NEW")
  /// Có giá trị khi người gửi TÌNH CỜ đang đăng nhập. Phần lớn là khách vãng
  /// lai nên null là trường hợp THƯỜNG, không phải ngoại lệ.
  ///
  /// CỐ Ý không có @relation sang `User` và không có FK dưới DB — y hệt
  /// memorial_tribute.user_id. Bảng public."User" TRỐNG (danh tính thật nằm ở
  /// auth.users của Supabase); đặt FK vào đây là làm MỌI thư của người đã đăng
  /// nhập vi phạm ràng buộc, tức là hỏng đúng nhóm người dùng tử tế nhất.
  user_id        String?  @db.Uuid
  /// sha256(ip + secret). Chỉ để gom cụm hành vi spam khi rà soát, KHÔNG để
  /// truy ra một con người — vì thế lưu hash chứ không lưu địa chỉ.
  sender_ip_hash String?
  created_at     DateTime @default(now())

  @@index([status, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("contact_message")
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
}

enum RelationshipNatureType {
  BIOLOGICAL
  ADOPTED
  SPOUSE
}

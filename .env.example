# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#
# Ở đây CHỈ có secret và endpoint theo môi trường. Các con số cấu hình
# (giới hạn upload, thời hạn presigned URL, hạn mức lưu trữ…) là HẰNG SỐ trong
# code — src/media/media.constants.ts và src/contact/contact.constants.ts —
# chứ không phải biến môi trường: chúng không bí mật, không đổi theo môi trường,
# và để trong code thì đọc được ngay cạnh phần giải thích tại sao chọn con số đó.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# DATABASE_URL: pooler PgBouncer, cổng 6543 — app dùng cái này.
# DIRECT_URL:   session mode, cổng 5432 — Prisma migrate và pg_dump dùng cái này.
#               pg_dump KHÔNG chạy được qua pooler.
# Cả hai đọc bởi Prisma qua prisma/schema.prisma, không qua process.env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
# Hệ API key MỚI — legacy `anon` / `service_role` đã bị tắt trên dashboard.
# Backend CHỈ cần secret key (bỏ qua RLS, tuyệt đối không để lộ ra client);
# publishable key `sb_publishable_…` là việc của frontend.
# Lấy ở Dashboard → Settings → API keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret ký JWT của chính app này (KHÔNG phải JWT secret của Supabase).
# Đổi giá trị = đăng xuất toàn bộ phiên đang mở.
JWT_SECRET=
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Dùng đúng tên biến Vercel Marketplace tự inject để local và production không
# lệch nhau. Bộ UPSTASH_REDIS_REST_* là fallback (redis.provider.ts:10).
# Chỉ là cache — không cần backup.
REDIS_2_KV_REST_API_URL=
REDIS_2_KV_REST_API_TOKEN=

# ── Kho ảnh ───────────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: 'r2' hoặc 'vercel-blob'. Thiếu credential thì tự rơi về
# provider còn lại (storage.service.ts).
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
# Chỉ cần khi STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# ── Backup (xem docs/BACKUP_RESTORE.md) ───────────────────────────────────────
# Passphrase mã hoá dump. MẤT PASSPHRASE = MẤT TOÀN BỘ BACKUP.
# Lưu ở password manager, KHÔNG chỉ lưu trong GitHub Secrets.
BACKUP_GPG_PASSPHRASE=
# Bucket R2 riêng cho backup, tách khỏi bucket ảnh.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# ── Queue (Upstash QStash) ────────────────────────────────────────────────────
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
APP_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000
# Băm IP người gửi form liên hệ để rà lạm dụng. Trống = bỏ trống sender_ip_hash.
CONTACT_IP_HASH_SECRET=
